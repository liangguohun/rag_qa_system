{
    "local-tools": {
        "command": "python",
        "args": ["mcp_server.py"],
        "transport": "stdio",
        "enabled": true
    },
    "mariadb": {
        "transport": "streamable_http",
        "url": "http://127.0.0.1:9001/mcp",
        "enabled": true
    },
    "custom-tools": {
        "command": "python",
        "args": ["custom_mcp_server.py"],
        "transport": "stdio",
        "enabled": false
    }
}
